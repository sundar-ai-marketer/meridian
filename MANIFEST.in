# NOTICE: This file was modified from the original google/meridian source.
# See the NOTICE file at the repository root for details.

include meridian/templates/*
recursive-include meridian/templates/assets *
# Apache 2.0 section 4(d): a redistribution has to carry the NOTICE file.
# TRIAGE.md is what the NOTICE points at for what changed and why.
include NOTICE
include TRIAGE.md
include AUDIT.md
recursive-include docs/validation *.json
include docs/validation/os-triage-latest.md
include docs/validation/native-report-browser-2026-10-02/orchestrator.py
include docs/validation/native-report-browser-2026-10-02/run.log
# Source distributions retain the test suite. The wheel build separately
# filters `_test.py` modules and package data so tests stay out of runtime
# installs without being lost from the source archive.
recursive-include meridian *_test.py
recursive-include scenarioplanner *_test.py
recursive-include scripts *.py
# The receipt inventories the source archive and records its digest. Keeping
# it inside that archive would make the source-archive digest self-referential.
exclude docs/validation/package-audit-*.json
